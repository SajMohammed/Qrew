# ─────────────────────────────────────────────────────────────
# Qrew — local development environment
# Copy to `.env` (never commit .env). Deployed envs use me-central-1.
# ─────────────────────────────────────────────────────────────

# Admin / owner connection — runs migrations and system jobs.
# In local Docker this is the `postgres` superuser, which BYPASSES RLS (by design).
DATABASE_URL="postgres://postgres:postgres@localhost:5432/qrew"

# Application connection — the `qrew_app` role, which is SUBJECT to RLS.
# The API and the RLS test use this so tenant isolation is actually enforced.
DATABASE_URL_APP="postgres://qrew_app:qrew_app@localhost:5432/qrew"

# Redis backs the wallet-sync queue. The API enqueues jobs; the wallet-worker
# (apps/wallet-worker) drains them and updates passes off the request path.
REDIS_URL="redis://localhost:6379"
# WALLET_WORKER_CONCURRENCY=5   # optional: jobs the worker runs at once (default 5)

# Wallet adapter behind the WalletProvider port. Defaults to an in-memory fake;
# set to `passkit` (with PASSKIT_API_KEY) in deployed envs once wired.
# WALLET_PROVIDER=fake

# ── Auth (Clerk) — staff/owner sign-in for the dashboard + scanner.
# Create a standard Clerk app (Organizations NOT needed — we use the flat staff-table model),
# then `clerk link --app <id>` + `clerk env pull` to populate the secret + publishable keys.
CLERK_SECRET_KEY=            # backend: verifies session JWTs (keep private, never in client code)
CLERK_PUBLISHABLE_KEY=       # written by `clerk env pull`
VITE_CLERK_PUBLISHABLE_KEY=  # frontends (dashboard + scanner) — same value as the publishable key
# Local/CI escape hatch: when NODE_ENV=development, accept the x-merchant-id header if there's no
# Bearer token (staff), and accept a dev.<sub>.<email> customer token, so dev works before real
# provider keys exist. NEVER enable in production.
AUTH_DEV_BYPASS=true
# CORS_ORIGINS=https://app.qrew.ae,https://scan.qrew.ae   # prod only; dev is same-origin via Vite

# ── Customer accounts — consumer "all my cards" app (separate from Clerk staff auth).
# Create a Google OAuth 2.0 Client ID (Web application) in Google Cloud; add the card app's origin
# to Authorized JavaScript origins. Same value both places (server verifies, client renders the button).
GOOGLE_CLIENT_ID=            # backend: verifies the Google ID token's audience
VITE_GOOGLE_CLIENT_ID=       # card app: renders the Google Identity Services button (same value)
# Secrets for our own HMAC-signed tokens. Generate strong random values in deployed envs
# (e.g. `openssl rand -hex 32`); dev falls back to built-in placeholders.
# CUSTOMER_TOKEN_SECRET=      # customer access token (15-min, subject = account id)
# STAFF_TOKEN_SECRET=         # cashier shift token (from a PIN check)
# CARD_TOKEN_SECRET=          # card QR token

API_PORT=4000
NODE_ENV=development
